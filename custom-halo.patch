index 00000000..b3090a9a
--- /dev/null
+++ b/port/android/app/src/main/java/com/halo/decomp/CommunityJoinPolicy.java
@@ -0,0 +1,12 @@
+package com.halo.decomp;
+
+final class CommunityJoinPolicy {
+    static String unavailable(String invite, int version, int ours, int players, int maximum, boolean open) {
+        if (invite == null || !invite.matches("[0-9a-fA-F]{64}")) return "Invalid invite";
+        if (version != ours) return "Different network version (" + version + ")";
+        if (players < 0 || maximum < 1 || maximum > 128 || players > maximum) return "Invalid player count";
+        if (!open) return "Game in progress";
+        if (players >= maximum) return "Game full";
+        return null;
+    }
+}
