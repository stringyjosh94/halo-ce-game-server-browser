+        browser_button(260, 300, 220, "Cancel");
+    }
+    else
+    {
+        snprintf(text, sizeof(text), "%d rooms / Milenko and shared invites", browser_view.count);
+        browser_text_draw(16, 56, text, 62);
+        if (!browser_view.count)
+        {
+            browser_text_draw(20, 150, "Waiting for public hosts...", 60);
+            browser_text_draw(20, 190, "Copy any shared link, then choose Add invite.", 60);
+            browser_text_draw(20, 230, "Host a System Link game, then choose Public.", 60);
+        }
+        for (row = 0; row < 5 && browser_page * 5 + row < browser_view.count; row++)
+        {
+            const struct p2p_browser_entry *entry = &browser_view.entries[browser_page * 5 + row];
+            int y = 100 + row * 56;
+            browser_rect(16, y, 768, 50, .04f, .11f, .17f);
+            if (entry->maximum) snprintf(text, sizeof(text), "%s  %d/%d", entry->name[0] ? entry->name : "Halo lobby", entry->players, entry->maximum);
+            else snprintf(text, sizeof(text), "%s  ?/?", entry->name);
+            browser_text_draw(112, y + 5, entry->name[0] ? entry->name : "Halo lobby", 37);
+            if (entry->maximum) snprintf(text, sizeof(text), "%d/%d", entry->players, entry->maximum);
+            else snprintf(text, sizeof(text), "?/?");
+            browser_text_draw(580, y + 5, text, 7);
+            snprintf(text, sizeof(text), "%s / %s", entry->map, entry->mode);
+            browser_text_draw(112, y + 26, text, 44);
+            browser_map_art(row, entry->map, 24, y + 5);
+            browser_rect(112, y + 44, 540, 3, .08f, .18f, .25f);
+            if (entry->maximum && entry->players > 0) browser_rect(112, y + 44, 540 * (entry->players < entry->maximum ? entry->players : entry->maximum) / entry->maximum, 3, .18f, .65f, .7f);
+            browser_button(680, y + 5, entry->saved ? 56 : 96,
+                entry->joinable && (!entry->maximum || entry->players < entry->maximum) ? (p2p_browser_join_active() && !strcmp(browser_selected_invite, entry->invite) ? (entry->saved ? "End" : "Cancel") : (entry->saved ? "Go" : "Join")) : (entry->saved ? "-" : "Closed"));
+            if (entry->saved) browser_button(740, y + 5, 40, "X");
+        }
+        if (!browser_notice[0] && browser_selected_invite[0] && p2p_browser_join_active() &&
+            SDL_GetTicks() - browser_join_started >= 10000)
+            browser_text_draw(16, 390, "Still waiting? Cancel. Switch Wi-Fi / 4G/5G then retry.", 64);
+        else browser_text_draw(16, 390, browser_notice, 64);
+        browser_button(16, 420, 150, browser_view.public_game ? "Public: on" : "Private");
+        browser_button(174, 420, 150, "Copy invite");
+        browser_button(332, 420, 150, "Add invite");
+        browser_button(490, 420, 142, "Previous");
+        snprintf(text, sizeof(text), "Next %d/%d", browser_page + 1, browser_view.count ? (browser_view.count + 4) / 5 : 1);
+        browser_button(640, 420, 144, text);
+    }
+    glDisable(GL_SCISSOR_TEST);
+}
