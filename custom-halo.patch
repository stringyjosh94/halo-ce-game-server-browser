+        char path[1024], key[32]; FILE *file; int n;
+        snprintf(key, sizeof(key), "%s", map);
+        for (n = 0; key[n]; n++) {
+            if (key[n] >= 'A' && key[n] <= 'Z') key[n] += 'a' - 'A';
+            if (!((key[n] >= 'a' && key[n] <= 'z') || (key[n] >= '0' && key[n] <= '9') || key[n] == '_')) key[n] = '_';
+        }
+        snprintf(path, sizeof(path), "%s/community_art_%s.rgb", platform_save_root(), key);
+        file = fopen(path, "rb"); browser_art_ready[row] = file && fread(pixels, 1, 2400, file) == 2400;
+        if (file) fclose(file);
