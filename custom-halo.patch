diff --git a/port/linux/src/p2p_browser_community.h b/port/linux/src/p2p_browser_community.h
new file mode 100644
index 00000000..f44d231e
--- /dev/null
+++ b/port/linux/src/p2p_browser_community.h
@@ -0,0 +1,30 @@
+/* Private Android cache produced atomically by CommunityDirectoryClient.
+   The records reuse the bounded, tested public advertisement decoder. */
+#ifndef P2P_BROWSER_COMMUNITY_H
+#define P2P_BROWSER_COMMUNITY_H
+#include <stdio.h>
+#include "p2p_browser_protocol.h"
+
+static int browser_community_read(FILE *file, unsigned long now,
+    struct p2p_browser_entry *entries, int limit, int *state)
+{
+    unsigned char header[12], wire[BROWSER_WIRE_SIZE];
+    unsigned long written;
+    int i, count;
+    *state = 0;
+    if (!file || fread(header, 1, sizeof(header), file) != sizeof(header) ||
+        memcmp(header, "HCM1", 4) || header[10] || header[11] ||
+        (header[8] != 1 && header[8] != 2)) return 0;
+    written = ((unsigned long)header[4] << 24) | ((unsigned long)header[5] << 16) |
+        ((unsigned long)header[6] << 8) | header[7];
+    if (written > now + 5 || (now > written && now - written >= 35)) return 0;
+    count = header[9];
+    if (count > 64 || count > limit || (header[8] == 2 && count)) return 0;
+    for (i = 0; i < count; i++)
+        if (fread(wire, 1, sizeof(wire), file) != sizeof(wire) ||
+            !browser_decode(wire, sizeof(wire), &entries[i])) return 0;
+    if (fgetc(file) != EOF || ferror(file)) return 0;
+    *state = header[8];
+    return count;
+}
+#endif
