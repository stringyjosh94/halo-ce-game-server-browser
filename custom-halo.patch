+    snapshot->online = p2p.running; snapshot->connected = p2p_signal_connected();
+    snapshot->hosting = p2p.hosting; snapshot->public_game = p2p.browser_public;
+    memcpy(snapshot->status, p2p.browser_status, sizeof(snapshot->status));
+    for (i = 0; i < p2p.saved_count; i++)
+    {
+        for (j = 0; j < snapshot->count; j++)
+            if (!strcmp(snapshot->entries[j].invite, p2p.saved[i].invite)) break;
+        if (j == snapshot->count)
+        {
+            int k; unsigned char hash[P2P_KEY_HASH_SIZE], token[P2P_TOKEN_SIZE], identifier[P2P_IDENTIFIER_SIZE];
+            snapshot->entries[snapshot->count++] = p2p.saved[i];
+            parse_invite(p2p.saved[i].invite, hash, token);
+            p2p_identifier_from_hash(hash, identifier);
+            for (k = 0; k < P2P_BROWSER_LIMIT; k++)
+            {
+                struct peer *peer;
+                if (!p2p.known_games[k].used || memcmp(p2p.known_games[k].identifier, identifier, P2P_IDENTIFIER_SIZE) ||
+                    browser_expired(p2p_now(), p2p.known_games[k].heard)) continue;
+                peer = find_peer(p2p.known_games[k].identifier);
+                if (!peer || !peer->connected) continue;
+                snapshot->entries[j] = p2p.known_games[k].entry;
+                memcpy(snapshot->entries[j].invite, p2p.saved[i].invite, sizeof(snapshot->entries[j].invite));
+                snapshot->entries[j].saved = 1;
+                break;
+            }
+        }
+        else snapshot->entries[j].saved = 1;
+    }
+    pthread_mutex_unlock(&p2p_lock);
+#ifdef HALO_ANDROID
+    {
+        char path[1024]; FILE *file; int count, state;
+        struct p2p_browser_entry entries[64];
+        snprintf(path, sizeof(path), "%s/community_games.bin", platform_save_root());
+        file = fopen(path, "rb");
+        count = browser_community_read(file, (unsigned long)time(NULL), entries, 64, &state);
+        if (file) fclose(file);
+        for (i = 0; i < count; i++)
+        {
+            for (j = 0; j < snapshot->count; j++)
+                if (!strcmp(snapshot->entries[j].invite, entries[i].invite)) break;
+            if (j < snapshot->count) {
+                entries[i].saved = snapshot->entries[j].saved;
+                snapshot->entries[j] = entries[i];
+            } else if (snapshot->count < P2P_BROWSER_RESULT_LIMIT)
+                snapshot->entries[snapshot->count++] = entries[i];
+        }
+        if (!snapshot->status[0]) snprintf(snapshot->status, sizeof(snapshot->status), "%s", state == 1 ?
+            "Milenko + shared invites - reported player counts" : state == 2 ?
+            "Milenko unavailable. Retrying; shared invites still work." :
+            "Loading Milenko community games...");
+    }
+#endif
+}
+void p2p_set_game_details(const char *name, const char *map, const char *mode, int joinable)
+{
+    pthread_mutex_lock(&p2p_lock);
+    browser_text(p2p.game_name, name, sizeof(p2p.game_name));
+    browser_text(p2p.game_map, map, sizeof(p2p.game_map));
+    browser_text(p2p.game_mode, mode, sizeof(p2p.game_mode));
+    p2p.game_joinable = joinable;
+    pthread_mutex_unlock(&p2p_lock);
+}
+
+void p2p_browser_game_received(const unsigned char *identifier, const char *name, const char *map,
+    int mode, int players, int maximum, int joinable)
+{
+    static const char *modes[] = {"None", "CTF", "Slayer", "Oddball", "King", "Race"};
+    int i, slot = -1; struct p2p_browser_entry entry = {0};
+    if (players < 0 || maximum < 1 || maximum > 128 || players > maximum) return;
+    pthread_mutex_lock(&p2p_lock);
+    for (i = 0; i < P2P_BROWSER_LIMIT; i++)
+    {
+        if (p2p.known_games[i].used && !memcmp(p2p.known_games[i].identifier, identifier, P2P_IDENTIFIER_SIZE)) { slot = i; break; }
+        if (!p2p.known_games[i].used || browser_expired(p2p_now(), p2p.known_games[i].heard)) slot = i;
+    }
+    if (slot >= 0)
+    {
+        const char *cursor;
+        for (cursor = map; *cursor; cursor++) if (*cursor == '/' || *cursor == '\\') map = cursor + 1;
+        browser_text(entry.name, name, sizeof(entry.name)); browser_text(entry.map, map, sizeof(entry.map));
+        browser_text(entry.mode, joinable < 0 ? "Incompatible" : (mode >= 0 && mode < 6 ? modes[mode] : "Custom"), sizeof(entry.mode));
+        entry.players = players; entry.maximum = maximum; entry.joinable = joinable > 0 && players < maximum;
+        memcpy(p2p.known_games[slot].identifier, identifier, P2P_IDENTIFIER_SIZE);
+        p2p.known_games[slot].entry = entry; p2p.known_games[slot].heard = p2p_now(); p2p.known_games[slot].used = 1;
+    }
+    pthread_mutex_unlock(&p2p_lock);
+}
