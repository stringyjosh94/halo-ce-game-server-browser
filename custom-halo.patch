+    }
+    browser_rect(x, y, 80, 40, .1f, .22f, .3f);
+    if (!browser_art_ready[row]) { browser_text_draw(x + 10, y + 13, "HALO", 4); return; }
+    for (a = 0; a < 20; a++) for (b = 0; b < 40;) {
+        int end = b + 1; unsigned char *pixel = pixels + (a * 40 + b) * 3;
+        while (end < 40 && !memcmp(pixel, pixels + (a * 40 + end) * 3, 3)) end++;
+        browser_rect(x + b * 2, y + a * 2, (end - b) * 2, 2, pixel[0] / 255.f, pixel[1] / 255.f, pixel[2] / 255.f); b = end;
+    }
+}
+static void browser_draw(void)
+{
+    char text[160]; int row;
+    if (!input_state.ui_pointer) { if (browser_visible) browser_show(0); return; }
+    SDL_GetWindowSizeInPixels(platform_window, &browser_width, &browser_height);
+    if (browser_width <= 0 || browser_height <= 0) return;
+    glEnable(GL_SCISSOR_TEST); glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    if (!browser_visible)
+    {
+        browser_button(650, 8, 134, "Servers");
