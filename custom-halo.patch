+    int n;
+    for (n = 0; text[n] && n < limit; n++)
+    {
+        char c = text[n]; const char *glyph; int row, column;
+        if (c >= 'a' && c <= 'z') c -= 'a' - 'A';
+        glyph = strchr(browser_font_chars, c);
+        if (!glyph) glyph = strchr(browser_font_chars, '?');
+        for (row = 0; row < 7; row++)
+            for (column = 0; column < 5; column++)
+                if (browser_font[glyph - browser_font_chars][row] & (16 >> column))
+                    browser_rect(x + n * 12 + column * 2, y + row * 2, 2, 2, .86f, .94f, 1.0f);
+    }
+}
+static void browser_button(int x, int y, int w, const char *label)
+{
+    browser_rect(x, y, w, 40, .08f, .22f, .34f);
+    browser_text_draw(x + 10, y + 13, label, (w - 16) / 12);
+}
+static void browser_show(int visible)
+{
+    browser_visible = visible; browser_confirm_public = 0;
+    if (!visible) { browser_selected_invite[0] = 0; browser_notice[0] = 0; browser_join_started = 0; }
+    p2p_browser_open(visible);
+    platform_mouse_capture(!visible && !input_state.mouse_released && !input_state.ui_pointer);
+    memset(input_state.keys, 0, sizeof(input_state.keys));
+    memset(keys_pressed, 0, sizeof(keys_pressed));
+    memset(input_state.mouse_buttons, 0, sizeof(input_state.mouse_buttons));
+    input_state.mouse_dx = input_state.mouse_dy = 0;
+    browser_snapshot_time = 0;
+}
+static void browser_update_view(void)
+{
+    if (!browser_snapshot_time || SDL_GetTicks() - browser_snapshot_time >= 250)
+    {
+        p2p_browser_snapshot(&browser_view);
+        browser_snapshot_time = SDL_GetTicks();
+        if (browser_page * 5 >= browser_view.count) browser_page = browser_view.count ? (browser_view.count - 1) / 5 : 0;
+    }
+}
+static void browser_click(float x, float y)
+{
+    int row;
+    if (!browser_visible)
+    {
+        if (x >= 650 && y >= 8 && y < 48) browser_show(1);
+        return;
+    }
+    if (x >= 650 && y >= 8 && y < 48) { browser_show(0); return; }
+#ifdef HALO_ANDROID
+    if (x >= 540 && x < 638 && y >= 8 && y < 48) {
+        char path[1024]; FILE *file;
+        snprintf(path, sizeof(path), "%s/community_diagnostics_request", platform_save_root());
+        file = fopen(path, "wb");
+        if (file) { fputc('1', file); fclose(file); }
+        return;
+    }
+#endif
+    if (browser_confirm_public)
+    {
+        if (y >= 300 && y < 340)
+        {
+            if (x >= 20 && x < 240) p2p_browser_public(1);
+            browser_confirm_public = 0; browser_snapshot_time = 0;
+        }
+        return;
+    }
+    browser_update_view();
+    if (y >= 420 && y < 460)
+    {
+        if (x >= 16 && x < 166)
+        {
+            if (browser_view.public_game) p2p_browser_public(0);
+            else if (browser_view.online) browser_confirm_public = 1;
+            browser_snapshot_time = 0;
+        }
+        else if (x >= 174 && x < 324)
+        {
+            p2p_browser_copy_invite();
+            snprintf(browser_notice, sizeof(browser_notice), "%s", browser_view.hosting ? "Invite copied." : "Create a System Link game first.");
+        }
+        else if (x >= 332 && x < 482)
+        {
+            char *text = SDL_GetClipboardText();
+            snprintf(browser_notice, sizeof(browser_notice), "%s", text && p2p_browser_add_invite(text) ?
+                "Invite saved on this device. Tap Join to connect." : "Could not save: invalid invite, list full, or storage error.");
+            SDL_free(text); browser_snapshot_time = 0;
+        }
+        else if (x >= 490 && x < 632 && browser_page) browser_page--;
+        else if (x >= 640 && browser_page * 5 + 5 < browser_view.count) browser_page++;
+        return;
+    }
+    row = (int)(y - 100) / 56;
+    if (y >= 100 && y < 380 && x >= 680 && row < 5 && browser_page * 5 + row < browser_view.count)
+    {
+        struct p2p_browser_entry *entry = &browser_view.entries[browser_page * 5 + row];
+        if (x >= 736 && entry->saved)
+        {
+            snprintf(browser_notice, sizeof(browser_notice), "%s", p2p_browser_remove_invite(entry->invite) ?
+                "Saved invite removed." : "Could not remove saved invite.");
+            browser_snapshot_time = 0;
+        }
+        else if (entry->joinable && (!entry->maximum || entry->players < entry->maximum))
+        {
+            if (p2p_browser_join_active() && !strcmp(browser_selected_invite, entry->invite)) {
+                p2p_browser_cancel_join(); browser_selected_invite[0] = 0; browser_notice[0] = 0; browser_join_started = 0;
+            } else if (p2p_browser_request_join(entry->invite)) {
+                snprintf(browser_selected_invite, sizeof(browser_selected_invite), "%s", entry->invite);
+                browser_join_started = SDL_GetTicks();
+                browser_notice[0] = 0;
+            } else {
+                snprintf(browser_notice, sizeof(browser_notice), "Could not join this room. Try another server.");
+            }
+            browser_snapshot_time = 0;
+        }
+    }
+}
+static int browser_event(const SDL_Event *event)
+{
+    if (!input_state.ui_pointer) return 0;
+    if (event->type == SDL_EVENT_KEY_DOWN && !event->key.repeat && event->key.scancode == SDL_SCANCODE_F8)
+    { browser_show(!browser_visible); return 1; }
+    if (browser_visible && event->type == SDL_EVENT_KEY_DOWN &&
+        (event->key.scancode == SDL_SCANCODE_ESCAPE || event->key.scancode == SDL_SCANCODE_AC_BACK))
+    { browser_show(0); return 1; }
+    if (event->type == SDL_EVENT_FINGER_DOWN)
+    {
+        float x = event->tfinger.x * 800, y = event->tfinger.y * 480;
+        int consumed = browser_visible || (x >= 650 && y >= 8 && y < 48);
+        if (consumed) browser_click(x, y);
+        return consumed;
+    }
+    if (event->type == SDL_EVENT_MOUSE_BUTTON_DOWN && event->button.button == SDL_BUTTON_LEFT)
+    {
+        int w, h; float x, y;
+        SDL_GetWindowSize(platform_window, &w, &h);
+        if (w <= 0 || h <= 0) return browser_visible;
+        x = event->button.x * 800 / w; y = event->button.y * 480 / h;
+        if (browser_visible || (input_state.ui_pointer && x >= 650 && y >= 8 && y < 48))
+        { browser_click(x, y); return 1; }
+    }
+    if (browser_visible && (event->type == SDL_EVENT_KEY_DOWN || event->type == SDL_EVENT_KEY_UP ||
+        event->type == SDL_EVENT_MOUSE_MOTION || event->type == SDL_EVENT_MOUSE_BUTTON_UP ||
+        event->type == SDL_EVENT_MOUSE_WHEEL || event->type == SDL_EVENT_FINGER_UP ||
+        event->type == SDL_EVENT_FINGER_MOTION)) return 1;
+    return 0;
+}
+static void browser_map_art(int row, const char *map, int x, int y)
+{
