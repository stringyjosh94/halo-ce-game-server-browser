+static void browser_publish(int stopped)
+{
+    char topic[TOPIC_SIZE];
+    unsigned char wire[BROWSER_WIRE_SIZE];
+    snprintf(topic, sizeof(topic), "%s%.32s", BROWSER_TOPIC, signalling.browser_host.invite + 12);
+    browser_encode(&signalling.browser_host, wire);
+    publish_everywhere(topic, wire, stopped ? 0 : BROWSER_WIRE_SIZE);
+    signalling.browser_sent = p2p_now();
+}
+static void browser_received(const char *topic, const unsigned char *payload, int size)
+{
+    struct p2p_browser_entry entry;
+    int i, slot = -1;
+    const char *hash = topic + strlen(BROWSER_TOPIC);
+    if (!signalling.browser_open || strlen(hash) != 32) return;
+    for (i = 0; i < P2P_BROWSER_LIMIT; i++)
+    {
+        if (signalling.listings[i].used && !strncmp(signalling.listings[i].entry.invite + 12, hash, 32))
+        {
+            slot = i; break;
+        }
+        if (!signalling.listings[i].used || browser_expired(p2p_now(), signalling.listings[i].heard)) slot = i;
+    }
+    if (slot < 0) return; /* bounded cache: floods cannot evict live hosts */
+    if (!size)
+    {
+        if (signalling.listings[slot].used && !strncmp(signalling.listings[slot].entry.invite + 12, hash, 32))
+            signalling.listings[slot].used = 0;
+        return;
+    }
+    if (!browser_decode(payload, size, &entry) || strncmp(entry.invite + 12, hash, 32) ||
+        !strncmp(entry.invite + 12, signalling.browser_host.invite + 12, 32)) return;
+    signalling.listings[slot].entry = entry;
+    signalling.listings[slot].heard = p2p_now();
+    signalling.listings[slot].used = 1;
+}
