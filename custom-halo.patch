diff --git a/tools/test_browser_protocol.c b/tools/test_browser_protocol.c
new file mode 100644
index 00000000..7e346071
--- /dev/null
+++ b/tools/test_browser_protocol.c
@@ -0,0 +1,34 @@
+/* Standalone: cc -Iport/linux/src -Iport/linux/include
+   -fsanitize=address,undefined tools/test_browser_protocol.c -o /tmp/browser-test */
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "p2p_browser_protocol.h"
+int main(void)
+{
+    struct p2p_browser_entry input = {0}, output;
+    unsigned char wire[BROWSER_WIRE_SIZE], fuzz[BROWSER_WIRE_SIZE];
+    int i, j;
+    strcpy(input.invite, "halo://join/0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef");
+    strcpy(input.name, "Test lobby"); strcpy(input.map, "bloodgulch"); strcpy(input.mode, "Slayer");
+    input.players = 128; input.maximum = 128; input.joinable = 0;
+    browser_encode(&input, wire);
+    assert(browser_decode(wire, sizeof(wire), &output));
+    assert(!strcmp(input.invite, output.invite) && !strcmp(input.name, output.name));
+    assert(output.players == 128 && output.maximum == 128 && !output.joinable);
+    for (i = 0; i < BROWSER_WIRE_SIZE; i++) assert(!browser_decode(wire, i, &output));
+    memcpy(fuzz, wire, sizeof(wire)); fuzz[9] = '/'; assert(!browser_decode(fuzz, sizeof(fuzz), &output));
+    memcpy(fuzz, wire, sizeof(wire)); fuzz[104] = 1; assert(!browser_decode(fuzz, sizeof(fuzz), &output));
+    memcpy(fuzz, wire, sizeof(wire)); fuzz[153] ^= 1; assert(!browser_decode(fuzz, sizeof(fuzz), &output));
+    input.players = 129; browser_encode(&input, fuzz); assert(!browser_decode(fuzz, sizeof(fuzz), &output));
+    assert(!browser_expired(34999, 0) && browser_expired(35000, 0));
+    assert(!browser_expired(100, 0xfffffff0UL));
+    assert(browser_expired(40000, 0xfffffff0UL));
+    for (i = 0; i < 10000; i++)
+    {
+        for (j = 0; j < (int)sizeof(fuzz); j++) fuzz[j] = rand() & 255;
+        browser_decode(fuzz, sizeof(fuzz), &output);
+    }
+    puts("Browser codec: boundary, malformed, compatibility, wraparound and fuzz tests passed.");
+    return 0;
+}
diff --git a/tools/test_browser_ui.c b/tools/test_browser_ui.c
new file mode 100644
index 00000000..ceb4e459
--- /dev/null
+++ b/tools/test_browser_ui.c
@@ -0,0 +1,79 @@
+/* UI interaction/render smoke test without copyrighted game assets.
+   cc -Iport/linux/src tools/test_browser_ui.c -lSDL3 -lGL -o build/browser-ui-test
+   SDL_VIDEODRIVER=offscreen build/browser-ui-test build/browser-preview.bmp */
+#include <SDL3/SDL.h>
+#include <SDL3/SDL_opengl.h>
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "p2p.h"
+typedef int BOOL;
+static SDL_Window *platform_window;
+static struct { int mouse_released, ui_pointer; unsigned char keys[SDL_SCANCODE_COUNT], mouse_buttons[8]; float mouse_dx, mouse_dy; } input_state;
+static unsigned char keys_pressed[SDL_SCANCODE_COUNT];
+static struct p2p_browser_snapshot fixture;
+static int published, joined, added, removed, reject_join, join_active, cancelled;
+void platform_mouse_capture(BOOL capture) { (void)capture; }
+void p2p_browser_open(int open) { if (!open) { join_active = 0; cancelled++; } }
+int p2p_browser_join_active(void) { return join_active; }
+void p2p_browser_cancel_join(void) { join_active = 0; cancelled++; }
+const char *platform_save_root(void) { return "/tmp"; }
+void p2p_browser_public(int enabled) { published = enabled; }
+void p2p_browser_copy_invite(void) {}
+void p2p_browser_snapshot(struct p2p_browser_snapshot *out) { *out = fixture; }
+int p2p_browser_add_invite(const char *text) { added++; return text && *text; }
+int p2p_browser_remove_invite(const char *text) { removed++; return text && *text; }
+int p2p_browser_request_join(const char *text) { joined++; join_active = !reject_join && text && *text; return join_active; }
+#include "p2p_browser_ui.h"
+int main(int argc, char **argv)
+{
+    SDL_GLContext context; SDL_Event touch = {0}; unsigned char pixels[800 * 480 * 4], flipped[sizeof(pixels)];
+    SDL_Surface *surface; int i;
+    assert(SDL_Init(SDL_INIT_VIDEO));
+    platform_window = SDL_CreateWindow("Browser test", 800, 480, SDL_WINDOW_OPENGL | SDL_WINDOW_HIDDEN);
+    assert(platform_window); context = SDL_GL_CreateContext(platform_window); assert(context);
+    input_state.ui_pointer = 1;
+    fixture.online = fixture.connected = 1; fixture.count = 3;
+    strcpy(fixture.entries[0].name, "Friday night Halo"); strcpy(fixture.entries[0].map, "bloodgulch");
+    strcpy(fixture.entries[0].mode, "Slayer"); strcpy(fixture.entries[0].invite, "halo://join/test");
+    fixture.entries[0].players = 5; fixture.entries[0].maximum = 16; fixture.entries[0].joinable = 1;
+    fixture.entries[1] = fixture.entries[0]; fixture.entries[1].players = 16; fixture.entries[1].joinable = 0;
+    strcpy(fixture.entries[1].name, "Full lobby");
+    fixture.entries[2] = fixture.entries[0]; fixture.entries[2].maximum = 0; fixture.entries[2].saved = 1;
+    strcpy(fixture.entries[2].name, "Saved host 0123456789ab"); strcpy(fixture.entries[2].map, "Shared invite / count unknown"); fixture.entries[2].mode[0] = 0; strcpy(fixture.entries[2].invite, "halo://join/other");
+    touch.type = SDL_EVENT_FINGER_DOWN; touch.tfinger.x = .9f; touch.tfinger.y = .05f;
+    assert(browser_event(&touch) && browser_visible);
+    browser_click(700, 120); assert(joined == 1);
+    assert(!browser_notice[0] && join_active);
+    browser_click(700, 120); assert(!join_active && cancelled);
+    browser_click(700, 120); assert(join_active && joined == 2);
+    strcpy(fixture.status, "Connected. Open Multiplayer > System Link to enter the lobby.");
+    browser_update_view(); assert(!browser_notice[0] && strstr(browser_view.status, "Connected"));
+    fixture.status[0] = 0; reject_join = 1;
+    join_active = 0; browser_click(700, 120); assert(strstr(browser_notice, "Could not join"));
+    reject_join = 0; joined = 1;
+    browser_click(700, 176); assert(joined == 1); /* full host is not joined */
+    browser_click(700, 232); assert(joined == 2); /* saved host can be tried */
+    browser_click(760, 232); assert(removed == 1);
+    browser_click(30, 435); assert(browser_confirm_public && !published);
+    browser_click(280, 320); assert(!browser_confirm_public && !published);
+    browser_click(30, 435); browser_click(30, 320); assert(published);
+    SDL_SetClipboardText("halo://join/test"); browser_click(350, 435); assert(added == 1);
+    browser_notice[0] = 0; browser_draw(); glFinish(); assert(glGetError() == GL_NO_ERROR);
+    glReadPixels(0, 0, 800, 480, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+    for (i = 0; i < 480; i++) memcpy(flipped + i * 3200, pixels + (479 - i) * 3200, 3200);
+    surface = SDL_CreateSurfaceFrom(800, 480, SDL_PIXELFORMAT_RGBA32, flipped, 3200); assert(surface);
+    if (argc > 1) assert(SDL_SaveBMP(surface, argv[1]));
+    SDL_DestroySurface(surface);
+    assert(join_active);
+    browser_click(700, 120); assert(join_active && !strcmp(browser_selected_invite, fixture.entries[0].invite));
+    touch.tfinger.y = .05f; assert(browser_event(&touch) && !browser_visible && !join_active);
+    assert(!browser_notice[0] && !browser_selected_invite[0]);
+    input_state.ui_pointer = 0;
+    assert(!browser_event(&touch) && !browser_visible); /* gameplay does not open invisible button */
+    input_state.ui_pointer = 1; browser_show(1);
+    input_state.ui_pointer = 0; browser_draw(); assert(!browser_visible); /* closes on gameplay */
+    SDL_GL_DestroyContext(context); SDL_DestroyWindow(platform_window); SDL_Quit();
+    puts("Browser UI: touch, public opt-in, full-lobby protection, saved joins/removal and GL render passed.");
+    return 0;
+}
