+
+static void browser_saved_path(char *path, int size)
+{
+    snprintf(path, size, "%s/browser_invites.txt", platform_save_root());
+}
+static int browser_saved_insert(const char *text)
+{
+    unsigned char hash[P2P_KEY_HASH_SIZE], token[P2P_TOKEN_SIZE], bytes[P2P_KEY_HASH_SIZE + P2P_TOKEN_SIZE];
+    struct p2p_browser_entry entry = {0};
+    int i;
+    if (parse_invite(text, hash, token) != 1) return 0;
+    memcpy(bytes, hash, sizeof(hash)); memcpy(bytes + sizeof(hash), token, sizeof(token));
+    memcpy(entry.invite, "halo://join/", 12); p2p_hex(bytes, sizeof(bytes), entry.invite + 12);
+    for (i = 0; i < p2p.saved_count; i++) if (!strcmp(p2p.saved[i].invite, entry.invite)) return 1;
+    if (p2p.saved_count >= P2P_BROWSER_SAVED_LIMIT) return 0;
+    snprintf(entry.name, sizeof(entry.name), "Saved host %.12s", entry.invite + 12);
+    snprintf(entry.map, sizeof(entry.map), "Shared invite / count unknown");
+    entry.joinable = entry.saved = 1;
+    p2p.saved[p2p.saved_count++] = entry;
+    return 1;
+}
+static void browser_saved_load(void)
+{
+    char path[1024], line[256]; FILE *file;
+    if (p2p.saved_loaded) return;
+    p2p.saved_loaded = 1;
+    browser_saved_path(path, sizeof(path)); file = fopen(path, "rb");
+    if (!file) return;
+    while (fgets(line, sizeof(line), file) && p2p.saved_count < P2P_BROWSER_SAVED_LIMIT) browser_saved_insert(line);
+    fclose(file);
+}
+static int browser_saved_write(void)
+{
+    char path[1024], temporary[1056]; FILE *file; int i, okay = 1;
+    browser_saved_path(path, sizeof(path)); snprintf(temporary, sizeof(temporary), "%s.partial", path);
+    file = fopen(temporary, "wb"); if (!file) return 0;
+    for (i = 0; i < p2p.saved_count; i++) if (fprintf(file, "%s\n", p2p.saved[i].invite) < 0) okay = 0;
+    if (fclose(file)) okay = 0;
+    if (okay && !rename(temporary, path)) return 1;
+    remove(temporary); return 0;
+}
+int p2p_browser_add_invite(const char *text)
+{
+    int before, result;
+    browser_saved_load(); before = p2p.saved_count;
+    if (!browser_saved_insert(text)) return 0;
+    result = browser_saved_write();
+    if (!result) p2p.saved_count = before;
+    return result;
+}
+int p2p_browser_remove_invite(const char *invite)
+{
+    int i; struct p2p_browser_entry backup[P2P_BROWSER_SAVED_LIMIT];
+    browser_saved_load(); memcpy(backup, p2p.saved, sizeof(backup));
+    for (i = 0; i < p2p.saved_count; i++) if (!strcmp(p2p.saved[i].invite, invite))
+    {
+        memmove(p2p.saved + i, p2p.saved + i + 1, (p2p.saved_count - i - 1) * sizeof(p2p.saved[0]));
+        p2p.saved_count--;
