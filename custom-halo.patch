+    }
+    browser_update_view();
+    browser_rect(0, 0, 800, 480, .02f, .055f, .09f);
+    browser_text_draw(16, 20, "HALO - COMMUNITY SERVERS", 48);
+    browser_button(650, 8, 134, "Close");
+#ifdef HALO_ANDROID
+    browser_button(540, 8, 98, "Logs");
+#endif
+    if (browser_confirm_public)
+    {
+        browser_text_draw(20, 110, "Publish this lobby?", 60);
+        browser_text_draw(20, 160, "Anyone can see its invite and request to join.", 60);
+        browser_text_draw(20, 200, "The public brokers can read lobby details.", 60);
