index 00000000..57358349
--- /dev/null
+++ b/tools/test_browser_community.c
@@ -0,0 +1,33 @@
+#include <assert.h>
+#include <stdio.h>
+#include "../port/linux/src/p2p_browser_community.h"
+
+static FILE *cache(int state, int count, const unsigned char *record, int size)
+{
+    unsigned char header[] = {'H','C','M','1',0,0,3,232,0,0,0,0};
+    FILE *file = tmpfile(); assert(file);
+    header[8] = state; header[9] = count;
+    assert(fwrite(header, 1, sizeof(header), file) == sizeof(header));
+    if (size) assert(fwrite(record, 1, size, file) == (size_t)size);
+    rewind(file); return file;
+}
+int main(void)
+{
+    struct p2p_browser_entry entry = {0}, entries[64];
+    unsigned char wire[BROWSER_WIRE_SIZE]; FILE *file; int state;
+    strcpy(entry.invite, "halo://join/"); memset(entry.invite + 12, 'a', 64);
+    strcpy(entry.name, "Community host"); entry.players = 12; entry.maximum = 128; entry.joinable = 1;
+    browser_encode(&entry, wire);
+    file = cache(1, 1, wire, sizeof(wire));
+    assert(browser_community_read(file, 1000, entries, 64, &state) == 1 && state == 1);
+    assert(entries[0].players == 12 && !strcmp(entries[0].name, entry.name));
+    rewind(file); assert(browser_community_read(file, 1034, entries, 64, &state) == 1);
+    rewind(file); assert(browser_community_read(file, 1035, entries, 64, &state) == 0 && state == 0);
+    rewind(file); assert(browser_community_read(file, 990, entries, 64, &state) == 0 && state == 0); fclose(file);
+    file = cache(2, 0, NULL, 0); assert(browser_community_read(file, 1000, entries, 64, &state) == 0 && state == 2); fclose(file);
+    file = cache(1, 0, NULL, 0); assert(browser_community_read(file, 1000, entries, 64, &state) == 0 && state == 1); fclose(file);
+    file = cache(1, 1, wire, sizeof(wire) - 1); assert(browser_community_read(file, 1000, entries, 64, &state) == 0 && state == 0); fclose(file);
+    file = cache(1, 65, wire, sizeof(wire)); assert(browser_community_read(file, 1000, entries, 64, &state) == 0 && state == 0); fclose(file);
+    wire[154]++; file = cache(1, 1, wire, sizeof(wire)); assert(browser_community_read(file, 1000, entries, 64, &state) == 0 && state == 0); fclose(file);
+    puts("Community cache: counts, freshness, malformed, bounds, empty and failed responses passed.");
+}
diff --git a/tools/test_browser_discovery.c b/tools/test_browser_discovery.c
new file mode 100644
index 00000000..885f9ce3
--- /dev/null
+++ b/tools/test_browser_discovery.c
@@ -0,0 +1,63 @@
+/* Build with the platform layer's i686 flags and -ffunction-sections
+   -fdata-sections -Wl,--gc-sections. No external broker or game data needed. */
+/* Native-host harness bypasses only the XDK ABI header. Transport is mocked. */
+#define __HALO_LINUX_PLATFORM_H
+#include <netinet/in.h>
+#define WSAEWOULDBLOCK 10035
+#define WSAEINPROGRESS 10036
+void platform_log(const char *format, ...);
+#include "../port/linux/src/p2p_signal.c"
+#include <assert.h>
+static unsigned long clock_ms;
+static unsigned char sent_packet[4096];
+static int sent_size;
+unsigned long p2p_now(void) { return clock_ms; }
+int posix_socket_close(int socket) { return 0; }
+int posix_socket_last_error(void) { return 0; }
+int posix_socket_send(int socket, const void *buffer, int length, int flags)
+{
+    assert(length <= (int)sizeof(sent_packet)); memcpy(sent_packet, buffer, length); sent_size = length; return length;
+}
+static void make_entry(struct p2p_browser_entry *entry, int host)
+{
+    char code[65]; memset(entry, 0, sizeof(*entry)); memset(code, 'a', 64); code[64] = 0;
+    code[0] = "0123456789abcdef"[(host >> 4) & 15]; code[1] = "0123456789abcdef"[host & 15];
+    snprintf(entry->invite, sizeof(entry->invite), "halo://join/%s", code);
+    strcpy(entry->name, "Test host"); entry->players = 4; entry->maximum = 16; entry->joinable = 1;
+}
+int main(void)
+{
+    struct p2p_browser_entry entry, entries[P2P_BROWSER_LIMIT]; unsigned char wire[BROWSER_WIRE_SIZE];
+    char topic[TOPIC_SIZE]; int i;
+    signalling.browser_open = 1;
+    make_entry(&entry, 1); browser_encode(&entry, wire);
+    snprintf(topic, sizeof(topic), "%s%.32s", BROWSER_TOPIC, entry.invite + 12);
+    browser_received(topic, wire, sizeof(wire));
+    assert(p2p_signal_browser_snapshot(entries) == 1 && entries[0].players == 4);
+    entry.players = 8; browser_encode(&entry, wire); clock_ms = 10000;
+    browser_received(topic, wire, sizeof(wire)); browser_received(topic, wire, sizeof(wire));
+    assert(p2p_signal_browser_snapshot(entries) == 1 && entries[0].players == 8); /* broker dedup */
+    clock_ms = 44999; assert(p2p_signal_browser_snapshot(entries) == 1);
+    clock_ms = 45000; assert(p2p_signal_browser_snapshot(entries) == 0); /* crashed host */
+    browser_received(topic, wire, sizeof(wire)); browser_received(topic, wire, 0);
+    assert(p2p_signal_browser_snapshot(entries) == 0); /* private/stop tombstone */
+    signalling.browser_open = 0; browser_received(topic, wire, sizeof(wire));
+    assert(p2p_signal_browser_snapshot(entries) == 0); /* no subscription, no incoming cache */
+    signalling.browser_open = 1;
+    for (i = 0; i < 80; i++)
+    {
+        make_entry(&entry, i); browser_encode(&entry, wire);
+        snprintf(topic, sizeof(topic), "%s%.32s", BROWSER_TOPIC, entry.invite + 12);
+        browser_received(topic, wire, sizeof(wire));
+    }
+    assert(p2p_signal_browser_snapshot(entries) == P2P_BROWSER_LIMIT); /* bounded flood */
+    signalling.broker_count = 1; signalling.brokers[0].state = _broker_ready; signalling.brokers[0].socket = 10;
+    make_entry(&entry, 99); sent_size = 0;
+    p2p_signal_browser_host(NULL); assert(!sent_size); /* private by default */
+    p2p_signal_browser_host(&entry); assert(sent_size && sent_packet[0] == 0x30); /* non-retained */
+    sent_size = 0; p2p_signal_browser_host(&entry); assert(!sent_size); /* unchanged counts */
+    entry.players++; p2p_signal_browser_host(&entry); assert(sent_size);
+    sent_size = 0; p2p_signal_browser_host(NULL); assert(sent_size && !signalling.browser_hosting);
+    puts("Discovery: broker dedup, heartbeat TTL, stop/private, bounded cache and publication tests passed.");
+    return 0;
+}
