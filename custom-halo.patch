diff --git a/port/android/app/src/main/java/com/halo/decomp/CommunityDirectoryClient.java b/port/android/app/src/main/java/com/halo/decomp/CommunityDirectoryClient.java
new file mode 100644
index 00000000..18cddb8e
--- /dev/null
+++ b/port/android/app/src/main/java/com/halo/decomp/CommunityDirectoryClient.java
@@ -0,0 +1,219 @@
+package com.halo.decomp;
+
+import android.app.Activity;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import java.util.LinkedHashSet;
+import java.util.HashMap;
+import android.os.SystemClock;
+import org.json.JSONArray;
+import org.json.JSONObject;
+import java.io.*;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.Locale;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+
+/** Fetches public games only while the existing in-game Servers panel is open. */
+final class CommunityDirectoryClient {
+    private final File root;
+    private final Activity activity;
+    private ScheduledExecutorService executor;
+    private volatile int generation;
+    private long lastFetch;
+    private final HashMap<String, Long> artAttempts = new HashMap<>();
+
+    CommunityDirectoryClient(Activity activity) {
+        this.activity = activity;
+        File data = activity.getExternalFilesDir(null);
+        root = data == null ? null : new File(data, "save");
+        if (root != null) new File(root, "community_browser_open").delete();
+    }
+    synchronized void start() {
+        if (root == null || executor != null) return;
+        lastFetch = -10000;
+        final int run = ++generation;
+        executor = Executors.newSingleThreadScheduledExecutor();
+        executor.scheduleWithFixedDelay(() -> tick(run), 0, 1, TimeUnit.SECONDS);
+    }
+    synchronized void stop() {
+        generation++;
+        if (executor != null) executor.shutdownNow();
+        executor = null;
+    }
+    private void tick(int run) {
+        if (run != generation) return;
+        File diagnostics = new File(root, "community_diagnostics_request");
+        if (diagnostics.exists() && diagnostics.delete()) showDiagnostics(run);
+        try (InputStream in = new FileInputStream(new File(root, "community_browser_open"))) {
+            if (in.read() != '1') return;
+        } catch (IOException e) { return; }
+        long now = SystemClock.elapsedRealtime();
+        if (now - lastFetch < 10000) return;
+        lastFetch = now;
+        HttpURLConnection connection = null;
+        try {
+            connection = (HttpURLConnection)new URL("https://halo.milenko.org/v1/games").openConnection();
+            connection.setConnectTimeout(10000); connection.setReadTimeout(10000);
+            connection.setRequestProperty("Accept", "application/json");
+            connection.setRequestProperty("User-Agent", "Halo-CE-Browser-Android/3");
+            if (connection.getResponseCode() != 200) throw new IOException("Directory unavailable");
+            JSONArray games;
+            try (InputStream in = connection.getInputStream(); ByteArrayOutputStream out = new ByteArrayOutputStream()) {
+                byte[] buffer = new byte[8192]; int n;
+                while ((n = in.read(buffer)) != -1) {
+                    if (out.size() + n > 1048576) throw new IOException("Directory response too large");
+                    out.write(buffer, 0, n);
+                }
+                games = new JSONObject(out.toString("UTF-8")).getJSONArray("games");
+            }
+            ByteArrayOutputStream records = new ByteArrayOutputStream();
+            int count = 0;
+            LinkedHashSet<String> mapImages = new LinkedHashSet<>();
+            for (int i = 0; i < games.length() && count < 64; i++) {
+                JSONObject game = games.optJSONObject(i);
+                if (game == null) continue;
+                String invite = game.optString("invite").toLowerCase(Locale.ROOT);
+                int players = game.optInt("players", -1), maximum = game.optInt("maximum_players", -1);
+                int version = game.optInt("version", -1);
+                boolean open = game.optInt("open", 0) == 1 || game.optBoolean("open", false);
+                if (!invite.matches("[0-9a-f]{64}") || players < 0 || maximum < 1 || maximum > 128 || players > maximum) continue;
+                String reason = CommunityJoinPolicy.unavailable(invite, version, BuildConfig.HALO_NETWORK_VERSION, players, maximum, open);
+                byte[] wire = new byte[159];
+                System.arraycopy("HCB1".getBytes(StandardCharsets.US_ASCII), 0, wire, 0, 4);
+                word(wire, 4, players); word(wire, 6, maximum); wire[8] = (byte)(reason == null ? 1 : 0);
+                System.arraycopy(invite.getBytes(StandardCharsets.US_ASCII), 0, wire, 9, 64);
+                text(wire, 73, 32, game.optString("name", "Halo lobby"));
+                String map = game.optString("map", "Unknown map").replace('\\', '/');
+                map = map.substring(map.lastIndexOf('/') + 1);
+                text(wire, 105, 32, map);
+                mapImages.add(map.toLowerCase(Locale.ROOT));
+                String[] modes = {"Custom", "CTF", "Slayer", "Oddball", "King", "Race"};
+                int mode = game.optInt("engine", 0);
+                String label = version != BuildConfig.HALO_NETWORK_VERSION ? "Incompatible"
+                    : !open ? "In progress" : players == maximum ? "Full"
+                    : (mode >= 0 && mode < modes.length ? modes[mode] : "Custom");
+                text(wire, 137, 16, label);
+                word(wire, 153, BuildConfig.HALO_NETWORK_VERSION); word(wire, 155, 128); word(wire, 157, 128);
+                records.write(wire); count++;
+            }
+            publish(run, 1, count, records.toByteArray());
+            int attempted = 0;
+            for (String map : mapImages) {
+                if (run != generation || Thread.currentThread().isInterrupted()) break;
+                if (cacheMapArt(run, map) && ++attempted >= 2) break;
+            }
+        } catch (Exception e) {
+            publish(run, 2, 0, new byte[0]);
+        } finally { if (connection != null) connection.disconnect(); }
+    }
+    private void showDiagnostics(int run) {
+        StringBuilder text = new StringBuilder("Halo CE Browser connection diagnostics\n");
+        text.append("Upstream: ").append(BuildConfig.HALO_UPSTREAM_BUILD)
+            .append("; network: ").append(BuildConfig.HALO_NETWORK_VERSION).append('\n');
+        File data = root.getParentFile();
+        try (RandomAccessFile log = new RandomAccessFile(new File(data, "debug.txt"), "r")) {
+            int length = (int)Math.min(log.length(), 96000);
+            log.seek(log.length() - length);
+            byte[] bytes = new byte[length]; log.readFully(bytes);
+            text.append(new String(bytes, StandardCharsets.UTF_8));
+        } catch (IOException e) { text.append("Game debug.txt unavailable: ").append(e.getClass().getSimpleName()).append('\n'); }
+        File androidLog = new File(activity.getCacheDir(), "connection-log.txt");
+        try {
+            Process logs = new ProcessBuilder("logcat", "-d", "-t", "500", "--pid=" + android.os.Process.myPid())
+                .redirectErrorStream(true).redirectOutput(androidLog).start();
+            if (!logs.waitFor(3, TimeUnit.SECONDS)) logs.destroy();
+            try (RandomAccessFile in = new RandomAccessFile(androidLog, "r")) {
+                int count = (int)Math.min(in.length(), 64000); byte[] bytes = new byte[count];
+                in.seek(in.length() - count); in.readFully(bytes);
+                text.append("\nAndroid engine log:\n").append(new String(bytes, StandardCharsets.UTF_8));
+            }
+        } catch (Exception e) { text.append("\nAndroid log unavailable.\n"); }
+        finally { androidLog.delete(); }
+        // Invite tokens confer access to lobbies; remove them before copying a report.
+        final String report = text.toString().replaceAll("(?i)[0-9a-f]{64}", "[invite removed]");
+        activity.runOnUiThread(() -> {
+            if (run != generation || activity.isFinishing()) return;
+            android.widget.TextView view = new android.widget.TextView(activity);
+            view.setText(report); view.setTextIsSelectable(true); view.setPadding(24, 16, 24, 16);
+            android.widget.ScrollView scroll = new android.widget.ScrollView(activity); scroll.addView(view);
+            new android.app.AlertDialog.Builder(activity).setTitle("Connection diagnostics").setView(scroll)
+                .setPositiveButton("Copy", (dialog, which) -> {
+                    android.content.ClipboardManager clipboard = (android.content.ClipboardManager)
+                        activity.getSystemService(android.content.Context.CLIPBOARD_SERVICE);
+                    if (clipboard != null) clipboard.setPrimaryClip(android.content.ClipData.newPlainText("Halo diagnostics", report));
+                }).setNegativeButton("Close", null).show();
+        });
+    }
+
+    // Only known Milenko map paths; images are optional and never gate joining.
+    private boolean cacheMapArt(int run, String map) {
+        if (!java.util.Arrays.asList("beavercreek", "bloodgulch", "boardingaction", "carousel", "chillout",
+                "damnation", "hangemhigh", "longest", "prisoner", "putput", "ratrace", "sidewinder", "wizard").contains(map)) return false;
+        File destination = new File(root, "community_art_" + map + ".rgb");
+        if (destination.length() == 2400) return false;
+        long now = SystemClock.elapsedRealtime();
+        if (artAttempts.containsKey(map) && now - artAttempts.get(map) < 60000) return false;
+        artAttempts.put(map, now);
+        HttpURLConnection connection = null;
+        Bitmap bitmap = null, small = null;
+        File temporary = new File(root, "community_art_" + map + ".partial");
+        try {
+            connection = (HttpURLConnection)new URL("https://halo.milenko.org/art/maps/" + map + ".jpg").openConnection();
+            connection.setInstanceFollowRedirects(false);
+            connection.setConnectTimeout(3000); connection.setReadTimeout(3000);
+            if (connection.getResponseCode() != 200) return true;
+            byte[] image;
+            try (InputStream in = connection.getInputStream(); ByteArrayOutputStream out = new ByteArrayOutputStream()) {
+                byte[] buffer = new byte[4096]; int n;
+                while ((n = in.read(buffer)) != -1) {
+                    if (out.size() + n > 524288) return true;
+                    out.write(buffer, 0, n);
+                }
+                image = out.toByteArray();
+            }
+            BitmapFactory.Options options = new BitmapFactory.Options(); options.inJustDecodeBounds = true;
+            BitmapFactory.decodeByteArray(image, 0, image.length, options);
+            if (options.outWidth <= 0 || options.outHeight <= 0 || options.outWidth > 4096 || options.outHeight > 4096) return true;
+            options.inJustDecodeBounds = false; options.inSampleSize = 1;
+            while (options.outWidth / options.inSampleSize > 160 || options.outHeight / options.inSampleSize > 80) options.inSampleSize *= 2;
+            bitmap = BitmapFactory.decodeByteArray(image, 0, image.length, options);
+            if (bitmap == null) return true;
+            small = Bitmap.createScaledBitmap(bitmap, 40, 20, true);
+            int[] pixels = new int[800]; small.getPixels(pixels, 0, 40, 0, 0, 40, 20);
+            try (OutputStream out = new FileOutputStream(temporary)) {
+                for (int pixel : pixels) { out.write((pixel >> 16) & 255); out.write((pixel >> 8) & 255); out.write(pixel & 255); }
+            }
+            synchronized (this) {
+                if (run == generation) { if (!temporary.renameTo(destination)) temporary.delete(); }
+                else temporary.delete();
+            }
+        } catch (Exception ignored) { temporary.delete(); }
+        finally {
+            if (small != null && small != bitmap) small.recycle();
+            if (bitmap != null) bitmap.recycle();
+            if (connection != null) connection.disconnect();
+        }
+        return true;
+    }
+    private synchronized void publish(int run, int state, int count, byte[] records) {
+        if (run != generation) return;
+        File temporary = new File(root, "community_games.partial"), destination = new File(root, "community_games.bin");
+        try (DataOutputStream out = new DataOutputStream(new FileOutputStream(temporary))) {
+            out.writeBytes("HCM1"); out.writeInt((int)(System.currentTimeMillis() / 1000));
+            out.writeByte(state); out.writeByte(count); out.writeShort(0); out.write(records);
+        } catch (IOException e) { temporary.delete(); return; }
+        if (!temporary.renameTo(destination)) temporary.delete();
+    }
+    private static void word(byte[] wire, int offset, int value) {
+        wire[offset] = (byte)(value >> 8); wire[offset + 1] = (byte)value;
+    }
+    private static void text(byte[] wire, int offset, int capacity, String value) {
+        for (int i = 0; i < value.length() && i < capacity - 1; i++) {
+            char c = value.charAt(i); wire[offset + i] = (byte)(c >= 32 && c <= 126 ? c : '?');
+        }
+    }
+}
