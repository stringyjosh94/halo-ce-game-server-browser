diff --git a/port/linux/src/p2p_browser_protocol.h b/port/linux/src/p2p_browser_protocol.h
new file mode 100644
index 00000000..d08d8564
--- /dev/null
+++ b/port/linux/src/p2p_browser_protocol.h
@@ -0,0 +1,61 @@
+/* Bounded, endian-independent public advertisements. No native structs on
+   the wire. No retained messages: a new browser waits for a live heartbeat.
+   This directory is not a trust boundary: all fields are host-reported. */
+#ifndef P2P_BROWSER_PROTOCOL_H
+#define P2P_BROWSER_PROTOCOL_H
+#include <string.h>
+#include "p2p.h"
+#include "halo_port_limits.h"
+enum { BROWSER_WIRE_SIZE = 159, BROWSER_HEARTBEAT = 10000, BROWSER_TTL = 35000 };
+#define BROWSER_TOPIC "hceu/browser-v1/"
+#define BROWSER_SUBSCRIPTION BROWSER_TOPIC "#"
+static void browser_text(char *out, const char *in, int capacity)
+{
+    int i;
+    for (i = 0; i < capacity - 1 && in[i]; i++)
+        out[i] = in[i] >= 32 && in[i] <= 126 ? in[i] : '?';
+    out[i] = 0;
+}
+static void browser_encode(const struct p2p_browser_entry *entry, unsigned char *wire)
+{
+    memset(wire, 0, BROWSER_WIRE_SIZE);
+    memcpy(wire, "HCB1", 4);
+    wire[153] = HALO_PORT_NETWORK_VERSION >> 8; wire[154] = HALO_PORT_NETWORK_VERSION & 255;
+    wire[155] = HALO_PORT_MAXIMUM_NETWORK_PLAYERS >> 8; wire[156] = HALO_PORT_MAXIMUM_NETWORK_PLAYERS & 255;
+    wire[157] = HALO_PORT_MAXIMUM_NETWORK_MACHINES >> 8; wire[158] = HALO_PORT_MAXIMUM_NETWORK_MACHINES & 255;
+    wire[4] = (unsigned char)(entry->players >> 8); wire[5] = (unsigned char)entry->players;
+    wire[6] = (unsigned char)(entry->maximum >> 8); wire[7] = (unsigned char)entry->maximum;
+    wire[8] = (unsigned char)entry->joinable;
+    memcpy(wire + 9, entry->invite + 12, 64);
+    browser_text((char *)wire + 73, entry->name, 32);
+    browser_text((char *)wire + 105, entry->map, 32);
+    browser_text((char *)wire + 137, entry->mode, 16);
+}
+static int browser_decode(const unsigned char *wire, int size, struct p2p_browser_entry *entry)
+{
+    int i, players, maximum;
+    if (size != BROWSER_WIRE_SIZE || memcmp(wire, "HCB1", 4) || wire[8] > 1)
+        return 0;
+    if (wire[153] * 256 + wire[154] != HALO_PORT_NETWORK_VERSION ||
+        wire[155] * 256 + wire[156] != HALO_PORT_MAXIMUM_NETWORK_PLAYERS ||
+        wire[157] * 256 + wire[158] != HALO_PORT_MAXIMUM_NETWORK_MACHINES) return 0;
+    players = wire[4] * 256 + wire[5]; maximum = wire[6] * 256 + wire[7];
+    if (maximum < 1 || maximum > 128 || players > maximum ||
+        wire[104] || wire[136] || wire[152]) return 0;
+    for (i = 9; i < 73; i++)
+        if (!((wire[i] >= '0' && wire[i] <= '9') || (wire[i] >= 'a' && wire[i] <= 'f'))) return 0;
+    memset(entry, 0, sizeof(*entry));
+    memcpy(entry->invite, "halo://join/", 12);
+    memcpy(entry->invite + 12, wire + 9, 64);
+    browser_text(entry->name, (const char *)wire + 73, 32);
+    browser_text(entry->map, (const char *)wire + 105, 32);
+    browser_text(entry->mode, (const char *)wire + 137, 16);
+    entry->players = players; entry->maximum = maximum; entry->joinable = wire[8];
+    return 1;
+}
+static int browser_expired(unsigned long now, unsigned long then)
+{
+    /* p2p's clock is 32-bit on every game ABI; explicitly wrap on test hosts. */
+    return ((now - then) & 0xffffffffUL) >= BROWSER_TTL;
+}
+#endif
